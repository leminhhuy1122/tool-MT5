# ========================================
# VietKey Gold AI — Environment Variables
# ========================================
# Sao chép file này thành .env và điền giá trị thật.
# KHÔNG BAO GIỜ commit file .env vào git.
# ========================================

# --- MetaTrader 5 ---
MT5_LOGIN=your_mt5_login_number
MT5_PASSWORD=your_mt5_password
MT5_SERVER=your_broker_server_name
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_SYMBOL=XAUUSD

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_or_channel_id

# --- Database ---
DATABASE_URL=sqlite:///data/vietkey_gold.db

# --- OpenAI / AI Newsroom (Tùy chọn) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# --- Ứng dụng ---
LOG_LEVEL=INFO
