# ============================================================================
# VIETKEY GOLD AI — Environment Configuration Template
# ============================================================================
# Sao chép file này thành .env và điền thông tin thực tế của bạn:
# cp .env.example .env

# --- MetaTrader 5 Configuration ---
MT5_LOGIN=your_mt5_account_number
MT5_PASSWORD=your_mt5_password
MT5_SERVER=your_broker_server_name
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_SYMBOL=XAUUSD

# --- Telegram Notifier Configuration ---
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=@your_channel_or_group_id
TELEGRAM_ENABLED=true
TELEGRAM_SEND_WAIT_SIGNALS=false

# --- Admin Security ---
# Khóa bảo mật API cho các thao tác quản trị (bắn tin, phát bản tin, cập nhật AI)
# Để trống sẽ tự động cho phép loopback nội bộ 127.0.0.1 và sinh key ngẫu nhiên
ADMIN_API_KEY=

# --- OpenAI Financial Newsroom (Tùy chọn) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
NEWS_AUTO_POST_ENABLED=false
NEWS_MORNING_POST_TIME=07:30
NEWS_AUTO_ALERT_RED=true

# --- Database & Strategy ---
DATABASE_PATH=data/vietkey.db
COOLDOWN_MINUTES=45
MAX_ACTIVE_SIGNALS=3
STRATEGY_VERSION=v1.0-M5
